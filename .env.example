# Payment agent benchmark — Lemonade LLM settings
# Copy to .env and edit: cp .env.example .env
# Bun loads .env automatically for `bun run bench`.

# OpenAI-compatible API base URL
# Default if unset: http://localhost:13305/v1
LEMONADE_BASE_URL=http://localhost:13305/v1

# Model id from GET http://localhost:13305/v1/models
# Sets DEFAULT_MODEL_ID used by the benchmark client and traces.
# Default if unset: Qwen3.5-9B-GGUF
LEMONADE_MODEL=Qwen3.5-9B-GGUF

# Other models available locally (examples):
# LEMONADE_MODEL=Gemma-4-E4B-it-GGUF
# LEMONADE_MODEL=Qwen3.5-4B-MTP-GGUF
# LEMONADE_MODEL=GLM-4.7-Flash-GGUF

# Authorization header value; local Lemonade does not require a real key
# Default if unset: not-needed-for-local-lemonade
LEMONADE_API_KEY=not-needed-for-local-lemonade
